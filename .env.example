# Copy to .env. Never use a NEXT_PUBLIC_ prefix for credentials.
MASSIVE_API_KEY=
DATABASE_URL=postgresql+psycopg://screener:screener@db:5432/screener
CORS_ORIGINS=["http://localhost:3000"]
DEMO_MODE=false
SCHEDULER_ENABLED=false
INITIAL_REFRESH_ENABLED=false
MASSIVE_REQUESTS_PER_MINUTE=5
INGEST_SYMBOLS=SPY,QQQ,IWM
# Optional future SEC integration; descriptive contact required by SEC policy.
SEC_USER_AGENT=
